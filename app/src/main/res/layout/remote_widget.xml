<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    android:orientation="vertical"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:contentDescription="BareRemote. Open remote and connection settings.">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BAREREMOTE"
                android:textColor="#FFFFFFFF"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/widget_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap to pair your TV"
                android:textColor="#FF999999"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <Button android:id="@+id/widget_sync" style="@style/WidgetRemoteButton"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_weight="0" android:layout_margin="0dp"
            android:text="↻" android:contentDescription="Sync: reconnect to TV" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button android:id="@+id/widget_back" style="@style/WidgetRemoteButton.Utility"
            android:text="Back" android:contentDescription="Back" />
        <Button android:id="@+id/widget_up" style="@style/WidgetRemoteButton"
            android:text="↑" android:contentDescription="Up" />
        <Button android:id="@+id/widget_power" style="@style/WidgetRemoteButton.Utility"
            android:text="Power" android:contentDescription="TV power" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button android:id="@+id/widget_left" style="@style/WidgetRemoteButton"
            android:text="←" android:contentDescription="Left" />
        <Button android:id="@+id/widget_ok" style="@style/WidgetRemoteButton"
            android:text="OK" android:textSize="20sp"
            android:fontFamily="sans-serif-medium" android:contentDescription="OK, select" />
        <Button android:id="@+id/widget_right" style="@style/WidgetRemoteButton"
            android:text="→" android:contentDescription="Right" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button android:id="@+id/widget_home" style="@style/WidgetRemoteButton.Utility"
            android:text="Home" android:contentDescription="TV home" />
        <Button android:id="@+id/widget_down" style="@style/WidgetRemoteButton"
            android:text="↓" android:contentDescription="Down" />
        <Button android:id="@+id/widget_play" style="@style/WidgetRemoteButton.Utility"
            android:text="Play / II" android:contentDescription="Play or pause" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <Button android:id="@+id/widget_volume_down" style="@style/WidgetRemoteButton.Utility"
            android:text="Vol −" android:contentDescription="Volume down" />
        <Button android:id="@+id/widget_mute" style="@style/WidgetRemoteButton.Utility"
            android:text="Mute" android:contentDescription="Toggle mute" />
        <Button android:id="@+id/widget_volume_up" style="@style/WidgetRemoteButton.Utility"
            android:text="Vol +" android:contentDescription="Volume up" />
    </LinearLayout>
</LinearLayout>
